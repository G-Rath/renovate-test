{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": null },
  "packageRules": [
    {
      "matchFileNames": [
        "pyproject.toml"
      ],
      "groupName": "python"
    }
  ],
  "rangeStrategy": "replace"
}
