{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchFileNames": [
        "pyproject.toml"
      ],
      "rangeStrategy": "update-lockfile",
      "groupName": "python"
    }
  ]
}
